# Copy only for local development.  Never commit real passwords or keys.
# ⚠ Every value below is a placeholder EXAMPLE that will be REJECTED in production.
SSWCENTER_ENVIRONMENT=development
SSWCENTER_APP_VERSION=3.0.0-alpha
SSWCENTER_DATABASE_URL=postgresql+psycopg://erp_app:CHANGE_ME@127.0.0.1/sswcenter_dev
SSWCENTER_DATA_ROOT=C:/ProgramData/SSWCenter/dev-data
SSWCENTER_DEV_LOGIN_BYPASS=false
SSWCENTER_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Production secrets – every value below is an intentionally invalid
# placeholder.  Production startup fails closed when any placeholder is
# detected.  Real credentials MUST be generated independently by an installer
# or secret manager using a CSPRNG and stored outside the repository.
#
# Requirements for production:
#   • Every application secret (PIN pepper, PIN lookup, CSRF signing,
#     transition token) is unique – never reuse a value across settings.
#   • Raw-string secrets must be at least 32 characters.
#   • SSWCENTER_RESIDENT_NUMBER_KEY_V1 and
#     SSWCENTER_RESIDENT_NUMBER_LOOKUP_KEY are canonical standard RFC 4648
#     base64 encodings of two independent 32-byte random values (44-character
#     strings after encoding).  The two decoded byte sequences must differ.
#   • The production database password must be high-diversity, at least 16
#     characters, and must not be reused as any application secret.
#   • The application rejects obvious weak material (placeholders, low
#     diversity, repeated units, ascending/descending sequences) but cannot
#     prove generation provenance – it trusts the operator to supply CSPRNG-
#     generated values.
# ---------------------------------------------------------------------------
SSWCENTER_PIN_PEPPER=CHANGE_ME
SSWCENTER_PIN_LOOKUP_KEY=CHANGE_ME
SSWCENTER_CSRF_SIGNING_KEY=CHANGE_ME
SSWCENTER_RESIDENT_NUMBER_KEY_V1=CHANGE_ME_BASE64_32_BYTE_KEY
SSWCENTER_RESIDENT_NUMBER_LOOKUP_KEY=CHANGE_ME_BASE64_32_BYTE_KEY
SSWCENTER_RESIDENT_NUMBER_ACTIVE_KEY_VERSION=1
# Dedicated W1D transition preview/apply HMAC key (never reuse CSRF/PIN secrets).
SSWCENTER_TRANSITION_TOKEN_KEY=CHANGE_ME
