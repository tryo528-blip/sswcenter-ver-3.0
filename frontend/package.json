{
  "name": "frontend",
  "private": true,
  "version": "3.0.0-alpha",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "npm run test:supported",
    "test:supported": "vitest run src/test --environment jsdom --maxWorkers=1 --exclude src/test/W1BRecipientsRed.test.tsx",
    "test:red:w1b": "vitest run src/test/W1BRecipientsRed.test.tsx --environment jsdom --maxWorkers=1",
    "test:historical": "npm run test:red:w1b",
    "test:e2e": "npm run test:e2e:full",
    "test:e2e:smoke": "playwright test --config=playwright.smoke.config.ts",
    "test:e2e:full": "playwright test --config=playwright.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.4",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "react-router": "8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
